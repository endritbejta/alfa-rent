generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  SERVICE
  INACTIVE
}

enum VehicleCategory {
  ECONOMY
  COMPACT
  SEDAN
  SUV
  LUXURY
  VAN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PICKUP
  RETURN
}

model User {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  password       String
  role           Role               @default(EMPLOYEE)
  active         Boolean            @default(true)
  /// Incrementing this immediately invalidates every previously issued JWT.
  sessionVersion Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  inspections    RentalInspection[]

  @@map("users")
}

model Vehicle {
  id           String          @id @default(cuid())
  slug         String          @unique
  brand        String
  model        String
  /// Registration plate — the identifier staff use to tell two identical
  /// cars apart. Optional so pre-existing rows stay valid.
  plate        String?         @unique
  year         Int
  category     VehicleCategory
  transmission Transmission
  fuelType     FuelType
  seats        Int
  pricePerDay  Decimal         @db.Decimal(10, 2)
  description  String
  status       VehicleStatus   @default(AVAILABLE)

  /// Legal compliance: the registration must be renewed before it expires,
  /// so the expiry drives fleet-wide warnings.
  registrationDate   DateTime?
  registrationExpiry DateTime?
  /// What the last registration renewal cost — feeds the cost overview.
  registrationCost   Decimal?  @db.Decimal(10, 2)
  /// Routine servicing, tracked separately from repairs: a service is
  /// upkeep, a repair is an unplanned cost.
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  /// What the last routine service cost (upkeep, not a repair).
  serviceCost        Decimal?  @db.Decimal(10, 2)
  serviceNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       VehicleImage[]
  reservations Reservation[]
  repairs      Repair[]

  @@index([status])
  @@index([category])
  @@index([registrationExpiry])
  @@map("vehicles")
}

/// An unplanned cost against a vehicle (accident, brakes, engine...).
/// Regular servicing is deliberately NOT recorded here so the yearly
/// repair spend per vehicle stays a true picture of what went wrong.
model Repair {
  id          String   @id @default(cuid())
  vehicleId   String
  date        DateTime
  cost        Decimal  @db.Decimal(10, 2)
  description String
  notes       String?
  reference   String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@map("repairs")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@index([createdAt])
  @@map("customers")
}

model Reservation {
  id          String            @id @default(cuid())
  vehicleId   String
  customerId  String
  pickupDate  DateTime
  returnDate  DateTime
  status      ReservationStatus @default(PENDING)
  totalPrice  Decimal           @db.Decimal(10, 2)
  notes       String?
  /// Actual handover and return timestamps. Scheduled dates remain unchanged
  /// so punctuality and overdue rentals can be audited later.
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  inspections RentalInspection[]

  @@index([vehicleId, pickupDate, returnDate])
  @@index([customerId])
  @@index([status])
  @@index([status, pickupDate])
  @@index([status, returnDate])
  @@index([createdAt])
  @@map("reservations")
}

/// Immutable condition record captured at the actual vehicle handover or
/// return. Scheduled reservation dates stay on Reservation; this records what
/// staff and the customer observed in person.
model RentalInspection {
  id             String         @id @default(cuid())
  reservationId  String
  createdById    String
  type           InspectionType
  mileage        Int
  fuelLevel      Int
  exteriorNotes  String?
  interiorNotes  String?
  damageFound    Boolean        @default(false)
  damageNotes    String?
  signerName     String
  acknowledgedAt DateTime
  createdAt      DateTime       @default(now())

  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  photos      InspectionPhoto[]

  @@unique([reservationId, type])
  @@index([createdById])
  @@map("rental_inspections")
}

model InspectionPhoto {
  id           String   @id @default(cuid())
  inspectionId String
  url          String
  publicId     String   @unique
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  inspection RentalInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, sortOrder])
  @@map("inspection_photos")
}

/// Fixed-window counters for abuse control. Kept in Postgres rather than a
/// separate cache because it is already shared by every serverless instance
/// — one fewer vendor to run, at the cost of a write per attempt.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}
