generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  SERVICE
  INACTIVE
}

enum VehicleCategory {
  ECONOMY
  COMPACT
  SEDAN
  SUV
  LUXURY
  VAN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// How staff settled a rental that came back after its booked return day.
enum LateReturnResolution {
  CHARGED
  WAIVED
}

enum InspectionType {
  PICKUP
  RETURN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  password               String
  role                   Role               @default(EMPLOYEE)
  active                 Boolean            @default(true)
  /// Incrementing this immediately invalidates every previously issued JWT.
  sessionVersion         Int                @default(0)
  /// Set when an admin creates the account or resets its password. The
  /// admin knows that temporary password, so the admin layout sends the
  /// holder to /account/password until they have chosen their own.
  mustChangePassword     Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  inspections            RentalInspection[]
  backfilledReservations Reservation[]      @relation("ReservationBackfill")
  auditEvents            AuditEvent[]

  @@map("users")
}

model Vehicle {
  id           String          @id @default(cuid())
  slug         String          @unique
  brand        String
  model        String
  /// Registration plate — the identifier staff use to tell two identical
  /// cars apart. Optional so pre-existing rows stay valid.
  plate        String?         @unique
  year         Int
  category     VehicleCategory
  transmission Transmission
  fuelType     FuelType
  seats        Int
  pricePerDay  Decimal         @db.Decimal(10, 2)
  description  String
  status       VehicleStatus   @default(AVAILABLE)

  /// RETIRED (October 2026): registration is no longer tracked. Nothing in
  /// the app reads or writes these three columns; they are kept only so the
  /// existing data survives. Drop them with a hand-written migration once
  /// the business confirms the data is no longer needed.
  registrationDate   DateTime?
  registrationExpiry DateTime?
  registrationCost   Decimal?  @db.Decimal(10, 2)
  /// Routine servicing, tracked separately from repairs: a service is
  /// upkeep, a repair is an unplanned cost.
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  /// What the last routine service cost (upkeep, not a repair).
  serviceCost        Decimal?  @db.Decimal(10, 2)
  serviceNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       VehicleImage[]
  reservations Reservation[]
  repairs      Repair[]

  @@index([status])
  @@index([category])
  @@index([registrationExpiry])
  @@map("vehicles")
}

/// An unplanned cost against a vehicle (accident, brakes, engine...).
/// Regular servicing is deliberately NOT recorded here so the yearly
/// repair spend per vehicle stays a true picture of what went wrong.
model Repair {
  id          String   @id @default(cuid())
  vehicleId   String
  date        DateTime
  cost        Decimal  @db.Decimal(10, 2)
  description String
  notes       String?
  reference   String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@map("repairs")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Customer {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String
  notes        String?
  /// Set when the personal data above was replaced with placeholders. The
  /// row stays so its reservations, and their amounts, stay for accounting.
  anonymisedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reservations Reservation[]

  @@index([createdAt])
  @@map("customers")
}

model Reservation {
  id                     String                @id @default(cuid())
  vehicleId              String
  customerId             String
  pickupDate             DateTime
  returnDate             DateTime
  status                 ReservationStatus     @default(PENDING)
  totalPrice             Decimal               @db.Decimal(10, 2)
  notes                  String?
  /// Hash of the customer-held capability token required to start payment.
  /// The raw token is returned once and is never stored.
  paymentAccessTokenHash String?               @unique
  /// The Idempotency-Key the creating request carried. A retry with the same
  /// key gets this reservation back instead of making a second one. Null for
  /// requests that sent none and for everything created before the column.
  idempotencyKey         String?               @unique
  /// What a public booking's form submitted, kept even when the email
  /// matched an existing customer whose record is (deliberately) left as it
  /// is. Staff compare it with the customer on file. Null for staff bookings
  /// and for everything created before the columns. Personal data: anonymising
  /// a customer must clear these too.
  contactFirstName       String?
  contactLastName        String?
  contactEmail           String?
  contactPhone           String?
  /// Actual handover and return timestamps. Scheduled dates remain unchanged
  /// so punctuality and overdue rentals can be audited later.
  startedAt              DateTime?
  completedAt            DateTime?
  /// Set when the rental was recorded after the fact in one step (no
  /// inspections) because nobody started it while it happened: when, by
  /// whom, and the staff's reason. Personal data may appear in the note, so
  /// anonymising a customer clears it.
  backfilledAt           DateTime?
  backfilledById         String?
  backfillNote           String?
  /// Set when the car came back after its booked return day (audit P2-4).
  /// The booked dates are not moved: these record the days past the return
  /// day, what was charged for them (already included in totalPrice; 0.00
  /// when waived), how staff settled it, and, when waived, why. The reason
  /// is staff free text that may name the customer, so anonymising clears it.
  lateDays               Int?
  lateCharge             Decimal?              @db.Decimal(10, 2)
  lateResolution         LateReturnResolution?
  lateWaiverReason       String?
  /// The storefront language a public request was made in ("sq" or "en").
  /// Every email to the customer about it is written in this language. Null
  /// for staff bookings and older rows, which use the default language.
  locale                 String?
  /// When the customer was emailed that their request lapsed unanswered.
  /// Expiry itself is derived, never stored; this marks the email as sent
  /// so the daily sweep sends it at most once (audit P2-13).
  expiryNotifiedAt       DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  backfilledBy User?              @relation("ReservationBackfill", fields: [backfilledById], references: [id], onDelete: SetNull)
  inspections  RentalInspection[]
  payments     Payment[]

  @@index([vehicleId, pickupDate, returnDate])
  @@index([customerId])
  @@index([status])
  @@index([status, pickupDate])
  @@index([status, returnDate])
  @@index([createdAt])
  @@map("reservations")
}

/// Payment attempts are deliberately separate from reservations: a customer
/// may retry, while each attempt keeps its own immutable amount and provider
/// reference for reconciliation. Card data must never be stored here.
model Payment {
  id                String        @id @default(cuid())
  reservationId     String
  provider          String
  providerPaymentId String?       @unique
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR") @db.VarChar(3)
  checkoutUrl       String?
  expiresAt         DateTime?
  paidAt            DateTime?
  lastEventAt       DateTime?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  events      PaymentEvent[]

  @@index([reservationId, createdAt])
  @@index([status])
  @@map("payments")
}

/// Normalized, idempotent gateway events. Raw webhook bodies are intentionally
/// not retained because banks may include sensitive customer/payment fields.
model PaymentEvent {
  id              String        @id @default(cuid())
  paymentId       String
  providerEventId String        @unique
  type            String
  status          PaymentStatus
  occurredAt      DateTime
  createdAt       DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, occurredAt])
  @@map("payment_events")
}

/// Immutable condition record captured at the actual vehicle handover or
/// return. Scheduled reservation dates stay on Reservation; this records what
/// staff and the customer observed in person.
model RentalInspection {
  id             String         @id @default(cuid())
  reservationId  String
  createdById    String
  type           InspectionType
  mileage        Int
  fuelLevel      Int
  exteriorNotes  String?
  interiorNotes  String?
  damageFound    Boolean        @default(false)
  damageNotes    String?
  signerName     String
  acknowledgedAt DateTime
  createdAt      DateTime       @default(now())

  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  photos      InspectionPhoto[]

  @@unique([reservationId, type])
  @@index([createdById])
  @@map("rental_inspections")
}

model InspectionPhoto {
  id           String   @id @default(cuid())
  inspectionId String
  url          String
  publicId     String   @unique
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  inspection RentalInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, sortOrder])
  @@map("inspection_photos")
}

/// Fixed-window counters for abuse control. Kept in Postgres rather than a
/// separate cache because it is already shared by every serverless instance
/// — one fewer vendor to run, at the cost of a write per attempt.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Who did what, when, and why: one row per staff write, inserted in the same
/// transaction as the change (src/lib/audit.ts). Append-only — a trigger the
/// model cannot express refuses UPDATE, DELETE and TRUNCATE, except the
/// actor's ON DELETE SET NULL and the anonymisation scrub. See the migration
/// 20261113180000_audit_events for why it is a trigger and not a REVOKE.
model AuditEvent {
  id        String   @id @default(cuid())
  /// Null for a system event, or once the staff account has been removed.
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// True for an event no person caused. Tells "system" apart from a NULL
  /// actorId left behind by a removed staff account.
  system    Boolean  @default(false)
  /// `<entity>.<verb>`, e.g. `reservation.cancel`. See AuditAction.
  action    String
  entity    String
  /// Not a foreign key: a deleted vehicle's or merged customer's history is
  /// the history most worth keeping.
  entityId  String
  /// Only the fields that changed. Never secrets or unneeded personal data.
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}
