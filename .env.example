# Database (Supabase PostgreSQL in production, local Postgres in development)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alfa_rent"

# Direct connection for Prisma migrations (Supabase pooler bypass)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alfa_rent"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app (http://localhost:3000 in development)
AUTH_URL="http://localhost:3000"

# Cloudinary — from dashboard.cloudinary.com
# NEVER put real values in this file; it is committed. Real values go in .env
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public contact details. Leave a channel empty to omit it from the site;
# never publish placeholder phone numbers or inboxes.
NEXT_PUBLIC_CONTACT_ADDRESS="Prishtina, Kosovo"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_MAP_URL=""

# Destructive seed safeguards. Never reuse production staff passwords.
# The seed refuses to run unless the acknowledgement is set exactly as shown.
ALLOW_DESTRUCTIVE_SEED=""
SEED_ADMIN_PASSWORD=""
SEED_EMPLOYEE_PASSWORD=""

# Online payments — keep disabled until a bank adapter has passed sandbox
# checkout, signature, duplicate-webhook, and reconciliation testing.
PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER=""
# Public HTTPS origin used to build return, cancel, and webhook URLs.
PAYMENT_APP_URL="http://localhost:3000"
# Add bank-specific merchant IDs and secrets only after choosing a provider.
# Never prefix payment credentials with NEXT_PUBLIC_.

# Booking emails (Resend). Leave any of these empty to send nothing.
# EMAIL_FROM must be on a domain verified in Resend, e.g.
# "Alfa Rent <rezervime@your-domain>". Until a domain exists, Resend's test
# sender "onboarding@resend.dev" only delivers to the Resend account's own
# address.
RESEND_API_KEY=""
EMAIL_FROM=""
# Who hears about new website booking requests; comma-separated.
STAFF_NOTIFICATION_EMAILS=""

# SEO. Both optional. SITE_URL is the public origin used in canonical tags,
# the sitemap and link previews; on Vercel it defaults to the project's
# production domain. Previews are never indexed; SITE_INDEXING="false"
# also closes a self-hosted deployment to search engines.
SITE_URL=""
SITE_INDEXING=""
